# Copy this file to .env.local and fill in the values.
# Never commit .env.local to git.

# ── Payload CMS ───────────────────────────────────────────────────────────────

# PostgreSQL connection string from Neon (neon.tech — free tier)
# Format: postgresql://user:password@host/dbname?sslmode=verify-ssl
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=verify-ssl

# Random secret used to sign Payload tokens — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=random-secret-here

# Umami Cloud credentials for analytics
NEXT_PUBLIC_UMAMI_WEBSITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
UMAMI_API_KEY=api-key-here

# Cloudflare R2 credentials for storage
R2_BUCKET=your-r2-bucket
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_ENDPOINT=https://your-r2-endpoint.r2.cloudflarestorage.com/lci-site-bucket
R2_REGION=your-r2-region # Usually 'auto'

# Cloudflare Turnstile credentials for WebRTC
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret

# Resend email credentials
RESEND_TO_EMAIL=the-email-to-send-to
RESEND_FROM_EMAIL=the-email-to-send-from # Default onboarding@resend.dev
RESEND_API_KEY=your-resend-api-key

# ── Optional ──────────────────────────────────────────────────────────────────

# Set to Vercel deployment URL in production (used by Payload for CORS)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
